{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "my-tasks-angular": {
      "projectType": "application",
      "root": "angular-tasks",
      "sourceRoot": "angular-tasks/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "public/angular/my-tasks",
              "browser": "browser"
            },
            "index": "angular-tasks/src/index.html",
            "browser": "angular-tasks/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "angular-tasks/tsconfig.app.json",
            "inlineStyleLanguage": "css",
            "styles": ["angular-tasks/src/styles.css"],
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  },
  "cli": {
    "analytics": "71f84606-5e12-44da-acfa-9ff623c59ed2"
  }
}
